# Tracked non-secret defaults. Environment variables override these values.

DTP_PROJECT="${DTP_PROJECT:-Parabank-Jenkins}"

SOATEST_SERVER="${SOATEST_SERVER:-https://localhost:9443}"
SOATEST_CONFIG="${SOATEST_CONFIG:-soatest.builtin://Demo Configuration}"
SOATEST_REPORT_ROOT="${SOATEST_REPORT_ROOT:-reports/soatest}"
JTEST_APP_COVERAGE_REPORT_ROOT="${JTEST_APP_COVERAGE_REPORT_ROOT:-report/app-coverage}"

CARGO_SERVLET_PORT="${CARGO_SERVLET_PORT:-8081}"
CARGO_TOMCAT_HOME="${CARGO_TOMCAT_HOME:-target/cargo/installs/tomcat-10.1.54/apache-tomcat-10.1.54}"
JTEST_MONITOR_HOME="${JTEST_MONITOR_HOME:-$CARGO_TOMCAT_HOME}"