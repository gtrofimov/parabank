FROM harbor.parasoft.com/ctp/ctp:2026.2.0 AS ctp

FROM tomcat:10.1.54-jre21-temurin-noble

ARG TOMCAT_HOME=/usr/local/tomcat

USER root:root

COPY target/parabank.war ${TOMCAT_HOME}/webapps
# monitor.zip entries are prefixed with "monitor/"; unzips to ${TOMCAT_HOME}/monitor
COPY target/jtest/monitor/monitor.zip ${TOMCAT_HOME}/monitor.zip
COPY docker-entrypoint-monitor.sh /usr/local/bin/docker-entrypoint-monitor.sh

# To enable injecting Virtualize JDBC driver into ParaBank, and to bake in the Jtest coverage agent
RUN apt update && \
    apt install -y unzip && \
    unzip ${TOMCAT_HOME}/webapps/parabank.war -d ${TOMCAT_HOME}/webapps/parabank && \
    rm ${TOMCAT_HOME}/webapps/parabank.war && \
    unzip ${TOMCAT_HOME}/monitor.zip -d ${TOMCAT_HOME} && \
    rm ${TOMCAT_HOME}/monitor.zip && \
    mkdir -p ${TOMCAT_HOME}/monitor/runtime_coverage && \
    chmod +x /usr/local/bin/docker-entrypoint-monitor.sh

# Use the agent version bundled with CTP so its runtime data matches the CTP
# jtestcov reader that processes application coverage.
COPY --from=ctp /usr/local/parasoft/ctp/webapps/em/coverage/Java/jtest_agent/agent.jar ${TOMCAT_HOME}/monitor/agent.jar
RUN sed -i \
    -e 's/^jtest.agent.session.autostart=true/jtest.agent.session.autostart=false/' \
    ${TOMCAT_HOME}/monitor/agent.properties

# Agent REST server (status/session control) is separate from the app's HTTP port;
# runtimeData is a volume mount point so host-side jtestcli can read flushed coverage.
ENV CATALINA_OPTS="-javaagent:${TOMCAT_HOME}/monitor/agent.jar=settings=${TOMCAT_HOME}/monitor/agent.properties,runtimeData=${TOMCAT_HOME}/monitor/runtime_coverage"

ENTRYPOINT ["/usr/local/bin/docker-entrypoint-monitor.sh"]

EXPOSE 8080
EXPOSE 8050
EXPOSE 61616
EXPOSE 9001
