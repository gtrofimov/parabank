# Copy to .env and set local secrets. Never commit .env.

# DTP publication credentials. Required only for Jtest -publish.
DTP_URL=
DTP_USER=
DTP_PASSWORD=

# SOAtest/SOAVirt basic authentication, if required.
SOATEST_AUTH=

# SOAVIRT file-staging credentials (soavirt-upload skill). SOAVIRT_URL is
# host:port (e.g. localhost:9080); split into --host/--port for the skill's
# scripts. SOAVIRT_AUTH is user:pass (basic auth, same colon-separated shape
# as SOATEST_AUTH above); split into SOAVIRT_USERNAME/SOAVIRT_PASSWORD, or
# leave SOAVIRT_AUTH empty and set SOAVIRT_BEARER_TOKEN instead. Matches the
# GitHub Actions repo secret names SOAVIRT_URL/SOAVIRT_AUTH.
SOAVIRT_URL=
SOAVIRT_AUTH=

# SOAtest MCP Basic auth token for CI discovery.
# The MCP URL is derived from ${SOATEST_URL:-$SOATEST_SERVER}/soavirt/mcp.
SOATEST_URL=
SOATEST_MCP_AUTH_TOKEN=

# Atlassian/Rovo discovery credentials, if required.
ROVO_EMAIL=
ROVO_TOKEN=