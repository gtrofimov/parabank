# Tracked non-secret defaults. Environment variables override these values.

DTP_PROJECT="${DTP_PROJECT:-Parabank-Jenkins}"
DTP_UT_COVERAGE_IMAGES="${DTP_UT_COVERAGE_IMAGES:-Parabank_All;Parabank_UnitTest}"
DTP_SOATEST_COVERAGE_IMAGES="${DTP_SOATEST_COVERAGE_IMAGES:-Parabank_All;Parabank_SOAtest}"

SOATEST_URL="${SOATEST_URL:-http://localhost:9080}"
SOATEST_SERVER="${SOATEST_SERVER:-https://localhost:9443}"
SOATEST_CONFIG="${SOATEST_CONFIG:-soatest.user://Example Configuration}"
REPORT_ROOT="${REPORT_ROOT:-reports}"
REPORT_JTEST_ROOT="${REPORT_JTEST_ROOT:-$REPORT_ROOT/jtest}"
REPORT_SOATEST_ROOT="${REPORT_SOATEST_ROOT:-$REPORT_ROOT/soatest}"
REPORT_APP_COVERAGE_ROOT="${REPORT_APP_COVERAGE_ROOT:-$REPORT_JTEST_ROOT/app-coverage}"
# Legacy aliases. Keep existing commands working.
SOATEST_REPORT_ROOT="${SOATEST_REPORT_ROOT:-$REPORT_SOATEST_ROOT}"
JTEST_APP_COVERAGE_REPORT_ROOT="${JTEST_APP_COVERAGE_REPORT_ROOT:-$REPORT_APP_COVERAGE_ROOT}"

PARABANK_SERVLET_PORT="${PARABANK_SERVLET_PORT:-8081}"
JTEST_AGENT_REST_PORT="${JTEST_AGENT_REST_PORT:-8050}"
PARABANK_DOCKER_CONTAINER="${PARABANK_DOCKER_CONTAINER:-parabank-parabank-1}"